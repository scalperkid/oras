<?xml version="1.0" encoding="utf-8"?>
<!-- Oras mark: a clock ring left deliberately open at the top, with a single hand.
     The gap reads as "time that runs out", not a generic clock face. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- open ring: arc from 12 o'clock clockwise around to ~11 o'clock -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 40.5,29.4"
        android:strokeColor="#FFEB681D"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- the hand, pointing to the gap -->
    <path
        android:pathData="M54,54 L54,38"
        android:strokeColor="#FFF9F7F1"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- pivot -->
    <path
        android:pathData="M54,54 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFF9F7F1" />
</vector>
