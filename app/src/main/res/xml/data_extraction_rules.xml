<?xml version="1.0" encoding="utf-8"?>
<!-- Codes and usage history never leave the phone. Nothing is backed up or transferred,
     so a cloud restore cannot resurrect an old code or an old set of limits. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
